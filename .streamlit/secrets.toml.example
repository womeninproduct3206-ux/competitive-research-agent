# Example secrets for Streamlit Community Cloud.
# Paste these lines (with your real values) into: your app -> Settings -> Secrets.
# Never commit a real secrets.toml file - it is listed in .gitignore.

AI_PROVIDER = "gemini"
GEMINI_API_KEY = "paste-your-gemini-key-here"
GEMINI_MODEL = "gemini-flash-latest"
APP_PASSWORD = "choose-a-strong-password"

# Optional - only if you switch AI_PROVIDER to "claude":
# ANTHROPIC_API_KEY = "paste-your-anthropic-key-here"
# CLAUDE_MODEL = "claude-opus-5-5"
