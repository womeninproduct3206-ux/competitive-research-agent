# Copy this file to ".env" and fill in your own values.
# The real .env file is ignored by git, so your secrets never leave your computer.

# Anthropic API key - needed from Milestone 4 (AI analysis). Leave blank for demo mode.
# Create one at https://console.anthropic.com (billed separately from Claude Pro).
ANTHROPIC_API_KEY=

# Which Claude model to use for analysis.
CLAUDE_MODEL=claude-opus-5-5

# Password people must enter to use the app. Leave blank to turn the password off (local use only).
APP_PASSWORD=
