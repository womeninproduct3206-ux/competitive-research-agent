# Copy this file to ".env" and fill in your own values.
# The real .env file is ignored by git, so your secrets never leave your computer.

# Which AI service analyses the pages: "gemini" (free tier available) or "claude" (paid).
AI_PROVIDER=gemini

# Google Gemini - free key from https://aistudio.google.com/apikey
# Note: on the free tier Google may use what you send to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Anthropic Claude - optional, paid. Key from https://console.anthropic.com (separate from Claude Pro).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Password people must enter to use the app. Leave blank to turn the password off (local use only).
APP_PASSWORD=
